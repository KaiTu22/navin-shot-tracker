rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules, then Publish.
// Replace YOUR_TRACKER_UID with the UID from Authentication -> Users (same value
// as TRACKER_UID in js/firebase-config.js).
//
// Read is public because a scopeId is an unguessable random string acting as the
// share link's access control (per the "unlisted link" design) - anyone with a
// scope's id can view its games, but only the signed-in tracker account can write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scopes/{scopeId}/games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "RBF5luSvWmhYtwDyi79jo3hxHAz1";
    }
  }
}
